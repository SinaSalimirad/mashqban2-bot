# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://mashqban:CHANGE_ME@localhost:5432/mashqban
# Host-run DATABASE_URL uses a URL-encoded password. Compose encodes POSTGRES_PASSWORD itself.
POSTGRES_PASSWORD=CHANGE_ME
BALE_BOT_TOKEN=
TEACHER_BALE_ID=
BOT_INSTANCE_KEY=mashqban-primary
# Generate with: openssl rand -hex 32
INVITE_CODE_SECRET=
FILE_STORAGE_DIR=./private-files
# Compose publishes app health endpoints and PostgreSQL on localhost only.
HTTP_PORT=8080
POSTGRES_PORT=5432
