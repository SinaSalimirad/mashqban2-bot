{
  "name": "mashqban-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test --check",
    "test:unit": "bun test --check tests/calendar.test.ts tests/config.test.ts tests/bale-client.test.ts tests/storage.test.ts tests/retention.test.ts",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:all": "bun run test:unit && bun run test:integration",
    "check:config": "bun run src/check-config.ts",
    "start": "bun run src/index.ts",
    "ops:outbox": "bun run src/operator.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  }
}
